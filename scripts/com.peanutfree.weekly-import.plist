<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.peanutfree.weekly-import</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>$HOME/Downloads/PeanutFreeNew/scripts/weekly-import.sh</string>
  </array>
  <!-- 매주 월요일 10:00 (Gemini 갱신 1시간 뒤. 맥이 꺼져 있었으면 켠 뒤 한 번 실행) -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>10</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/peanutfree-weekly-import.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/peanutfree-weekly-import.log</string>
</dict>
</plist>
